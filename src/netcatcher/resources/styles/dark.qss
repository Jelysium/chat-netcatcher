/* NetCatcher Dark Theme */

* {
    outline: none;
}

QMainWindow {
    background-color: #1e1e2e;
    color: #cdd6f4;
}

QMainWindow::separator {
    background-color: #313244;
    height: 1px;
    width: 1px;
}

QGroupBox {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 1px solid #313244;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 12px;
}

QGroupBox::title {
    color: #a6adc8;
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}

QWidget {
    background-color: #1e1e2e;
    color: #cdd6f4;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 13px;
}

/* Kill default white frame borders everywhere */
QFrame {
    border: none;
}

QToolBar {
    background-color: #181825;
    border: none;
    border-bottom: 1px solid #313244;
    padding: 4px;
    spacing: 6px;
}

QToolBar::separator {
    width: 1px;
    background-color: #313244;
    margin: 4px 2px;
}

QToolBar QToolButton {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 6px 14px;
    min-width: 60px;
}

QToolBar QToolButton:hover {
    background-color: #45475a;
}

QToolBar QToolButton:pressed {
    background-color: #585b70;
}

QLineEdit {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 5px 10px;
}

QLineEdit:focus {
    border-color: #89b4fa;
}

QTableView {
    background-color: #1e1e2e;
    alternate-background-color: #242437;
    color: #cdd6f4;
    gridline-color: #313244;
    selection-background-color: #313244;
    selection-color: #cdd6f4;
    border: none;
    outline: none;
}

QTableView::item:selected {
    background-color: #45475a;
}

QTableView::item:selected:!active {
    background-color: #45475a;
}

QTableView::item:focus {
    background-color: #585b70;
    border: 1px solid #89b4fa;
}

QHeaderView::section {
    background-color: #181825;
    color: #a6adc8;
    border: none;
    border-right: 1px solid #313244;
    border-bottom: 1px solid #313244;
    padding: 5px 8px;
    font-weight: bold;
}

QTabWidget::pane {
    border: none;
    background-color: #1e1e2e;
}

QTabWidget {
    background-color: #181825;
}

QTabBar {
    background-color: #181825;
}

QTabBar::tab {
    background-color: #181825;
    color: #a6adc8;
    border: 1px solid #313244;
    border-bottom: none;
    padding: 8px 20px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background-color: #1e1e2e;
    color: #89b4fa;
    border-bottom: 2px solid #89b4fa;
}

QTabBar::tab:hover:!selected {
    background-color: #313244;
}

QTreeWidget {
    background-color: #1e1e2e;
    alternate-background-color: #242437;
    color: #cdd6f4;
    border: none;
}

QTreeWidget::item:selected {
    background-color: #45475a;
}

QTextEdit {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: none;
}

QSplitter {
    background-color: #1e1e2e;
}

QSplitter::handle {
    background-color: #313244;
    height: 2px;
}

QStatusBar {
    background-color: #181825;
    color: #a6adc8;
    border-top: 1px solid #313244;
}

QComboBox {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 4px 8px;
}

QComboBox::drop-down {
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #1e1e2e;
    color: #cdd6f4;
    selection-background-color: #45475a;
    selection-color: #cdd6f4;
    border: 1px solid #313244;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 5px 10px;
    min-height: 24px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #313244;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #45475a;
}

QSpinBox {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 4px;
}

QCheckBox {
    color: #cdd6f4;
    spacing: 5px;
}

QScrollBar:vertical {
    background-color: #181825;
    width: 10px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #45475a;
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: #181825;
    height: 10px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #45475a;
    border-radius: 5px;
    min-width: 20px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* Scroll area corner widget */
QAbstractScrollArea {
    background-color: #1e1e2e;
    border: none;
}

/* Filter bar labels */
QLabel {
    color: #a6adc8;
    background: transparent;
}

/* Status bar capture indicator */
QStatusBar[label="capturing"] {
    background-color: #1a2e1a;
    border-top: 2px solid #a6e3a1;
}

/* Dropdown menus (Export, Theme) */
QMenu {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 1px solid #45475a;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px;
}

QMenu::item:hover,
QMenu::item:selected {
    background-color: #45475a;
}

QMenu::separator {
    height: 1px;
    background-color: #313244;
    margin: 4px 8px;
}

/* ToolButton dropdown menus */
QToolButton::menu-indicator {
    image: none;
    border: none;
}

QToolButton::menu-button {
    border: none;
}
